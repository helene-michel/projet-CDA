{% extends 'base.html.twig' %}

{% block title %}{{ seller.companyName }}{% endblock %}
{% block meta_description %}
{%- set description = (seller.description ?? '')|striptags|trim -%}
{{- description|length > 155 ? description|slice(0, 154) ~ '…' : description -}}
{% endblock %}

{% block body %}
<header class="page-head">
    <div class="container-xxl">
        <div class="breadcrumb-b">
            <a href="{{ path('app_base') }}">Accueil</a> /
            <a href="{{ path('app_creator_index') }}">Créatrices</a> /
            <span>{{ seller.companyName }}</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="avatar creator-avatar" aria-hidden="true">{{ include('creator/_initials.html.twig') }}</div>
            <div>
                <h1 class="mb-1">{{ seller.companyName }}</h1>
                {% if seller.user %}<span class="product-creator">par {{ seller.user.displayName }}</span>{% endif %}
            </div>
        </div>
        <p class="mt-3" style="max-width: 70ch">{{ seller.description|nl2br }}</p>
    </div>
</header>

<section class="container-xxl pb-5">
    <h2 class="h4 mb-3">Ses créations ({{ products|length }})</h2>
    <div class="row g-4">
        {% for product in products %}
        <div class="col-sm-6 col-lg-3">
            <div class="product-card">
                <a href="{{ path('app_article', { id: product.id }) }}" class="product-img d-block">
                    <img src="{{ product_image(product) }}" alt="" loading="lazy">
                </a>
                <div class="product-body">
                    <a href="{{ path('app_article', { id: product.id }) }}" class="product-title">{{ product.name }}</a>
                    <div class="product-footer"><span class="product-price">{{ price_incl_vat(product)|format_currency('EUR') }}</span></div>
                </div>
            </div>
        </div>
        {% else %}
        <p class="col-12">Aucune création en ligne pour le moment.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
