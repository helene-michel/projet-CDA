{# Conteneur des notifications (toasts) : affiche les messages flash et les notifications front.
   Inclus une seule fois par layout, avant le bloc body, pour consommer tous les flashs. #}
{% set flashes = app.flashes %}
<div class="notification-stack" aria-live="polite"
     {{ stimulus_controller('notification', flashes is empty ? {} : { flashes: flashes }) }}></div>
