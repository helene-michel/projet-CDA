<!-- ===================== NAVBAR ===================== -->
<nav class="navbar navbar-expand-lg navbar-lcdc sticky-top py-3 d-flex flex-column" data-controller='menu'>
  <div class="container-xxl">
    <a class="brand-mark" href="{{ path('app_base') }}">
      <img src="{{asset('images/aiguille.png')}}" width="26" height="26" alt="icone aiguille logo" />
      Le comptoire des couturiers
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navlcdc"
      aria-label="Ouvrir le menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navlcdc">
      <ul class="navbar-nav nav-links mx-auto mt-3 mt-lg-0">
        <li class="nav-item">
          <a data-action="click->menu#show" class="">Articles</a>
        </li>
        <li class="nav-item"><a href="#ateliers">Créatrices</a></li>
      </ul>

      <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
        {% if app.user %}
        {% set account_label = 'Mon compte, connecté en tant que ' ~ (app.user.prenom ?: app.user.userIdentifier) %}
        <a href="{{ path('app_login') }}" class="icon-btn is-connected" aria-label="{{ account_label }}"
          title="{{ account_label }}">
          {{ ux_icon('lucide:user-round-check', { 'aria-hidden': 'true' }) }}
        </a>
        {% else %}
        <a href="{{ path('app_login') }}" class="icon-btn" aria-label="Se connecter" title="Se connecter">
          {{ ux_icon('lucide:user-round', { 'aria-hidden': 'true' }) }}
        </a>
        {% endif %}
        {% set cart_items = cart_count() %}
        {% set cart_label = cart_items > 0
        ? 'Mon panier, ' ~ cart_items ~ ' article' ~ (cart_items > 1 ? 's')
        : 'Mon panier, vide' %}
        <a href="{{ path('app_cart') }}" class="icon-btn cart-btn{% if cart_items > 0 %} has-items{% endif %}"
          aria-label="{{ cart_label }}" title="{{ cart_label }}">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
            aria-hidden="true">
            <path class="cart-btn__bag" d="M4 7h16l-1.5 11a2 2 0 0 1-2 1.8H7.5a2 2 0 0 1-2-1.8L4 7Z" />
            <path d="M8 7V5a4 4 0 0 1 8 0v2" />
          </svg>
          {% if cart_items > 0 %}
          <span class="cart-btn__count" aria-hidden="true">{{ cart_items > 99 ? '99+' : cart_items }}</span>
          {% endif %}
        </a>
        <a href="#" class="btn-vendre">Commencer à vendre</a>
      </div>
    </div>
  </div>
  <div class="mega-menu hidden" data-menu-target="megaMenu">
    <div class="row g-4">
      {% for catGroup in getGroup() %}
      <div class="col-lg-3 mega-col">

        <h6><span class="ic" style="background:var(--rouge-fil)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 4h12l-1 6-3 2 3 2-1 6H6l-1-6 3-2-3-2z" />
            </svg>
          </span>{{catGroup.nom}}
        </h6>
        {% for cat in catGroup.category %}
        <a href="{{ path('app_articles', {id:cat.id}) }}">{{ cat.nom }}</a>
        {% endfor %}
      </div>
      {% endfor %}

    </div>
    <div class="mega-promo">
      <div>
        <strong>Le vestiaire bambin arrive sur Le comptoire des coutiriers</strong>
        <p>Petites séries cousues à la main, en coton bio français.</p>
      </div>
      <a href="#">Découvrir</a>
    </div>
  </div>
</nav>
