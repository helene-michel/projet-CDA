{% extends 'base.html.twig' %}

{% block title %}Créations cousues main par des créatrices françaises{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@graph': [
                { '@type': 'WebSite', name: site_name, url: url('app_base'), inLanguage: 'fr-FR' },
                { '@type': 'Organization', name: site_name, url: url('app_base'), logo: absolute_url(asset('icon-512.png')) },
            ],
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}
    </script>
{% endblock %}

{% block body %}

<!-- ===================== HERO ===================== -->
<header class="hero">
    <div class="container-xxl">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6 hero-fade">
                <span class="hero-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                    Plus de 600 couturières partout en France
                </span>
                <h1 class="mb-3">La couture faite à la main, juste à côté de chez vous</h1>
                <p class="lead mb-4">Le comptoire des couturiers réunit des couturières et des ateliers indépendants
                    partout en France, pour des vêtements, tissus et créations sur-mesure, cousus près de chez vous.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#categories" class="btn-primary-b">Découvrir les créations</a>
                    <a href="{{ path('seller_app_products_index') }}" class="btn-outline-b">Vendre mes créations</a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-collage hero-fade" style="animation-delay:.1s">
                    <div class="swatch s1"><img src="{{asset('images/blue-textile-texture.jpg')}}"
                            alt="matière textile lin"></div>
                    <div class="swatch s2"><img src="{{asset('images/rouge-textile-texture.jpg')}}"
                            alt="matière textile soie"></div>
                    <div class="swatch s3"><img src="{{asset('images/beige-textile-texture.jpg')}}"
                            alt="matière textile coton"></div>
                    <div class="swatch s4"><img src="{{asset('images/jaune-textile-texture.jpg')}}"
                            alt="matière textile velour"></div>
                    <div class="float-icon f1" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8">
                            <circle cx="12" cy="12" r="8" />
                            <circle cx="9" cy="9" r=".6" fill="currentColor" />
                            <circle cx="15" cy="9" r=".6" fill="currentColor" />
                            <circle cx="9" cy="15" r=".6" fill="currentColor" />
                            <circle cx="15" cy="15" r=".6" fill="currentColor" />
                        </svg>
                    </div>
                    <div class="float-icon f2" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8">
                            <path d="M3 21c4-1 7-3 9-5l7-7a2 2 0 0 0-3-3l-7 7c-2 2-4 5-5 9Z" />
                            <path d="M14 6l4 4" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="stitch"></div>

<!-- ===================== BANDE DE CONFIANCE ===================== -->
<section class="trust-band">
    <div class="container-xxl">
        <div class="row gy-3">
            <div class="col-md-4 trust-item">
                <span class="pastille"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.8">
                        <path d="M4 21V8l8-5 8 5v13" />
                        <path d="M9 21v-7h6v7" />
                    </svg></span>
                100% fabriqué en France
            </div>
            <div class="col-md-4 trust-item">
                <span class="pastille"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.8">
                        <rect x="4" y="10" width="16" height="10" rx="1" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg></span>
                Paiement sécurisé
            </div>
            <div class="col-md-4 trust-item">
                <span class="pastille"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.8">
                        <path d="M12 21c4-4 7-7.5 7-11a7 7 0 0 0-14 0c0 3.5 3 7 7 11Z" />
                        <circle cx="12" cy="10" r="2.4" />
                    </svg></span>
                Vendu directement par l'artisane
            </div>
        </div>
    </div>
</section>

<section class="py-5" id="categories">
    <div class="container-xxl">
        <div class="section-head">
            <h2>Nos créations</h2>
            <p>Vêtements et accessoires cousus main, rangés par univers.</p>
        </div>
        <div class="row g-4">
            {% for group in category_groups() %}
            <div class="col-sm-6 col-lg-3">
                <div class="collection-card">
                    <div class="collection-head">
                        <h3>{{ group.name }}</h3>
                        <span>{{ group.categories|length }} catégorie{{ group.categories|length > 1 ? 's' }}</span>
                    </div>
                    <ul class="collection-links">
                        {% for category in group.categories %}
                        <li><a href="{{ path('app_articles', { id: category.id }) }}">{{ category.name }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="py-5 mt-2 mb-4" style="background:var(--ivoire-dark)" id="ateliers">
    <div class="container-xxl py-4">
        <div class="section-head">
            <h2>Des créatrices à suivre</h2>
            <p>Une sélection d'ateliers indépendants, choisis pour la qualité de leur travail.</p>
        </div>

        <div class="row g-3">
            {% for seller in sellers %}
            <div class="col-sm-6 col-lg-3">
                <div class="atelier-card">
                    <div class="avatar">{{ seller.companyName|split(' ')|slice(0, 2)|map(word => word|first|upper)|join }}</div>
                    <h3>{{ seller.companyName }}</h3>
                    <p>{{ seller.description|length > 90 ? seller.description|slice(0, 89) ~ '…' : seller.description }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ===================== COMMENT ÇA MARCHE ===================== -->
<section class="py-5 my-4 dots">
    <div class="container-xxl">
        <div class="section-head">
            <h2>Comment ça marche</h2>
        </div>

        <div class="row etapes gy-4">
            <div class="col-md-4 etape">
                <div class="num">1</div>
                <h3>Parcourez</h3>
                <p>Explorez les créations, tissus et savoir-faire de couturières partout en France.</p>
            </div>
            <div class="col-md-4 etape">
                <div class="num">2</div>
                <h3>Échangez</h3>
                <p>Discutez directement avec l'artisane pour ajuster la taille, le tissu ou la finition.</p>
            </div>
            <div class="col-md-4 etape">
                <div class="num">3</div>
                <h3>Recevez</h3>
                <p>Votre pièce est cousue à la main et vous est livrée, prête à porter.</p>
            </div>
        </div>
    </div>
</section>



{% endblock %}
