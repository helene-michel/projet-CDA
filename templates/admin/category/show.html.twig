{% extends 'admin/adminbase.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1>Category</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ category.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_app_category_index') }}">back to list</a>

    <a href="{{ path('admin_app_category_edit', {'id': category.id}) }}">{{ ux_icon('lucide:pencil') }}</a>

    {{ include('admin/category/_delete_form.html.twig') }}
{% endblock %}
