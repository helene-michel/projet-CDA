{% extends 'admin/adminbase.html.twig' %}

{% block title %}Catégorie{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
    <h1>Catégorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ category.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_app_category_index') }}">Retour à la liste</a>

    <a href="{{ path('admin_app_category_edit', {'id': category.id}) }}">{{ ux_icon('lucide:pencil') }}</a>

    {{ include('admin/category/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
