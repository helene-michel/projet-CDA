{% extends 'admin/adminbase.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="main-area col-12">
        <div class="content">   
            <h1>Catégories</h1>
           
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-1 border border-secondary rounded p-2"><div class="puce">{{ categories|length }}</div> au total</div>
                <div> <a href="{{ path('admin_app_category_new') }}" class="btn btn-vendre">Ajouter</a></div>
               
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.id }}</td>
                            <td>{{ category.name }}</td>
                            <td>
                                <a href="{{ path('admin_app_category_show', {'id': category.id}) }}">{{ ux_icon('lucide:eye') }}</a>
                                <a href="{{ path('admin_app_category_edit', {'id': category.id}) }}">{{ ux_icon('lucide:pencil') }}</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">Aucun élément</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            
        </div>
    </div>
{% endblock %}
