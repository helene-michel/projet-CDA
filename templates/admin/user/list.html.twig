{% extends 'admin/adminbase.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
{% set currentRole = app.request.query.get('role') %}
<div class="main-area">
    <div class="content">
        <div class="page-title">
            <h1>Utilisateurs</h1>
            <p>Retrouvez toutes les vendeuses et clientes inscrites.</p>
        </div>

        <div class="users-toolbar">
            <form class="users-search" method="get">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A8578" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                {% if currentRole %}<input type="hidden" name="role" value="{{ currentRole }}">{% endif %}
                <input type="search" name="search" value="{{ app.request.query.get('search') }}" placeholder="Rechercher par nom ou email…" aria-label="Rechercher">
            </form>
            <div class="filter-tabs">
                <a href="{{ path('admin_app_user_index') }}" class="{{ not currentRole ? 'active' }}">Tous ({{ rolesCount['ROLE_USER'] }})</a>
                <a href="{{ path('admin_app_user_index', {role: 'ROLE_SELLER'}) }}" class="{{ currentRole == 'ROLE_SELLER' ? 'active' }}">Vendeur/ses ({{ rolesCount['ROLE_SELLER'] }})</a>
                <a href="{{ path('admin_app_user_index', {role: 'ROLE_ADMIN'}) }}" class="{{ currentRole == 'ROLE_ADMIN' ? 'active' }}">Administrateurs ({{ rolesCount['ROLE_ADMIN'] }})</a>
            </div>
        </div>

        <p class="results-count">Comptes trouvés : {{ users.getTotalItemCount }}</p>

        <div class="users-table-wrap">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Rôles</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td><div class="uname">{{ user.lastName }}</div></td>
                        <td><div class="uname">{{ user.firstName }}</div></td>
                        <td><div class="uemail">{{ user.email }}</div></td>
                        <td>
                            {% for role in user.roles %}
                            <span class="pill pill-{{ role }}"></span>
                            {% endfor %}
                        </td>
                        <td>
                            <div class="row-actions">
                                <a href="{{ path('admin_app_user_show', {id: user.id}) }}" title="Voir">{{ ux_icon('lucide:eye') }}</a>
                                <a href="{{ path('admin_app_user_edit', {id: user.id}) }}" title="Modifier">{{ ux_icon('lucide:pencil') }}</a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5">Aucun utilisateur.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="navigation">
                {{ knp_pagination_render(users) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
