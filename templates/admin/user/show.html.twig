{% extends 'admin/adminbase.html.twig' %}

{% block title %}{{ user.displayName }}{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
        <h1>{{ user.displayName }}</h1>
        <table class="table">
            <tbody>
                <tr><th>Prénom</th><td>{{ user.firstName ?: '—' }}</td></tr>
                <tr><th>Nom</th><td>{{ user.lastName ?: '—' }}</td></tr>
                <tr><th>Email</th><td>{{ user.email }}</td></tr>
                <tr><th>Rôles</th><td>{{ user.roles|join(', ') }}</td></tr>
                <tr><th>Email vérifié</th><td>{{ user.verified ? 'Oui' : 'Non' }}</td></tr>
                <tr><th>Produits</th><td>{{ user.products|length }}</td></tr>
            </tbody>
        </table>
        <div class="d-flex gap-3 align-items-center">
            <a href="{{ path('admin_app_user_index') }}">Retour à la liste</a>
            <a href="{{ path('admin_app_user_edit', {id: user.id}) }}">Modifier</a>
            {{ include('admin/user/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
