{% extends 'admin/adminbase.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <h1>Products</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ product.nom }}</td>
            </tr>
            <tr>
                <th>Prix_ht</th>
                <td>{{ product.prixHt }}</td>
            </tr>
            <tr>
                <th>TVA</th>
                <td>{{ product.TVA }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_app_products_index') }}">back to list</a>

    <a href="{{ path('admin_app_products_edit', {'id': product.id}) }}">edit</a>

    {{ include('admin/products/_delete_form.html.twig') }}
{% endblock %}
