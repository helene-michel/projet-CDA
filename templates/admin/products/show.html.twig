{% extends 'admin/adminbase.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
        <h1>{{ product.name }}</h1>
        <ul class="photo-list">
            {% for image in product_images(product) %}
            <li><img src="{{ image }}" alt="" width="88" height="88" loading="lazy"></li>
            {% endfor %}
        </ul>
        <table class="table mt-3">
            <tbody>
                <tr><th>Vendeur</th><td>{{ product.user ? product.user.displayName : '—' }}</td></tr>
                <tr><th>Catégorie</th><td>{{ product.category ? product.category.name : '—' }}</td></tr>
                <tr><th>Prix HT</th><td>{{ product.priceExclVat|format_currency('EUR') }}</td></tr>
                <tr><th>TVA</th><td>{{ product.vatRate|format_number }} %</td></tr>
                <tr><th>Prix TTC</th><td>{{ price_incl_vat(product)|format_currency('EUR') }}</td></tr>
                <tr><th>Description</th><td>{{ product.description }}</td></tr>
            </tbody>
        </table>
        <div class="d-flex gap-3 align-items-center">
            <a href="{{ path('admin_app_products_index') }}">Retour à la liste</a>
            <a href="{{ path('app_article', {id: product.id}) }}">Voir en boutique</a>
            <a href="{{ path('admin_app_products_edit', {id: product.id}) }}">Modifier</a>
            {{ include('admin/products/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
