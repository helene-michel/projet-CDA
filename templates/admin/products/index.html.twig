{% extends 'admin/adminbase.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Produits ({{ products|length }})</h1>
            <a href="{{ path('admin_app_products_new') }}" class="btn btn-vendre">Ajouter un produit</a>
        </div>
        <div class="users-table-wrap">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Vendeur</th>
                        <th class="num">Prix HT</th>
                        <th class="num">TVA</th>
                        <th class="num">Prix TTC</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                    <tr>
                        <td>
                            <div class="product-cell">
                                <img src="{{ product_image(product) }}" alt="" width="48" height="48" class="product-thumb" loading="lazy">
                                <div>
                                    <div class="pname">{{ product.name }}</div>
                                    <div class="pcat">{{ product.category ? product.category.name : 'Sans catégorie' }}</div>
                                </div>
                            </div>
                        </td>
                        <td>{{ product.user ? product.user.displayName : '—' }}</td>
                        <td class="num">{{ product.priceExclVat|format_currency('EUR') }}</td>
                        <td class="num">{{ product.vatRate|format_number }} %</td>
                        <td class="num">{{ price_incl_vat(product)|format_currency('EUR') }}</td>
                        <td>
                            <div class="row-actions">
                                <a href="{{ path('admin_app_products_show', {id: product.id}) }}" title="Voir">{{ ux_icon('lucide:eye') }}</a>
                                <a href="{{ path('admin_app_products_edit', {id: product.id}) }}" title="Modifier">{{ ux_icon('lucide:pencil') }}</a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6">Aucun produit.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
