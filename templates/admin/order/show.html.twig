{% extends 'admin/adminbase.html.twig' %}

{% block title %}Commande n° {{ order.id }}{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
        <h1>Commande n° {{ order.id }}</h1>
        <table class="table">
            <tbody>
                <tr><th>Date</th><td>{{ order.orderedAt|date('d/m/Y H:i') }}</td></tr>
                <tr><th>Client</th><td><a href="{{ path('admin_app_user_show', {id: order.user.id}) }}">{{ order.user.displayName }}</a> ({{ order.user.email }})</td></tr>
                <tr><th>Statut</th><td><span class="pill {{ order.paid ? 'pill-actif' : 'pill-attente' }}">{{ order.status.label }}</span></td></tr>
                <tr><th>Total TTC</th><td>{{ order.total|format_currency('EUR') }}</td></tr>
                <tr><th>Session Stripe</th><td>{{ order.stripeSessionId ?: '—' }}</td></tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4">Articles</h2>
        <div class="users-table-wrap">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Taille</th>
                        <th>Coloris</th>
                        <th class="num">Prix unitaire TTC</th>
                        <th class="num">Quantité</th>
                        <th class="num">Total TTC</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in order.lines %}
                    <tr>
                        <td>
                            {% if line.product %}
                            <a href="{{ path('admin_app_products_show', {id: line.product.id}) }}">{{ line.productName }}</a>
                            {% else %}
                            {{ line.productName }} <small>(produit supprimé)</small>
                            {% endif %}
                        </td>
                        <td>{{ line.size ? line.size|upper : '—' }}</td>
                        <td>{{ line.colorName ?: '—' }}</td>
                        <td class="num">{{ line.unitPrice|format_currency('EUR') }}</td>
                        <td class="num">{{ line.quantity }}</td>
                        <td class="num">{{ line.total|format_currency('EUR') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-3 align-items-center mt-3">
            <a href="{{ path('admin_app_order_index') }}">Retour à la liste</a>
        </div>
    </div>
</div>
{% endblock %}
