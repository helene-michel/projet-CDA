{% extends 'admin/adminbase.html.twig' %}

{% block title %}Matières{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
    <h1>Matières</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tag in tags %}
            <tr>
                <td>{{ tag.id }}</td>
                <td>{{ tag.name }}</td>
                <td>
                    <a href="{{ path('admin_app_tags_show', {'id': tag.id}) }}">{{ ux_icon('lucide:eye') }}</a>
                    <a href="{{ path('admin_app_tags_edit', {'id': tag.id}) }}">{{ ux_icon('lucide:pencil') }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun élément</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_app_tags_new') }}">Ajouter</a>
    </div>
</div>
{% endblock %}
