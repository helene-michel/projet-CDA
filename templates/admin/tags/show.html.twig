{% extends 'admin/adminbase.html.twig' %}

{% block title %}Tags{% endblock %}

{% block body %}
    <h1>Tags</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tag.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ tag.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_app_tags_index') }}">back to list</a>

    <a href="{{ path('admin_app_tags_edit', {'id': tag.id}) }}">{{ ux_icon('lucide:pencil') }}</a>

    {{ include('admin/tags/_delete_form.html.twig') }}
{% endblock %}
