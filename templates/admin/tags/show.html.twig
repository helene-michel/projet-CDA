{% extends 'admin/adminbase.html.twig' %}

{% block title %}Matière{% endblock %}

{% block body %}
<div class="main-area col-12">
    <div class="content">
    <h1>Matière</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tag.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ tag.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_app_tags_index') }}">Retour à la liste</a>

    <a href="{{ path('admin_app_tags_edit', {'id': tag.id}) }}">{{ ux_icon('lucide:pencil') }}</a>

    {{ include('admin/tags/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
