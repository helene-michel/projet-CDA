{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div  class="container">
    <div class='row'>
        <div class="col-12 d-flex flex-column justify-content-center align-items-center">
            <fieldset class="bgForm">
                    <legend><h1 class="h3 my-3 font-weight-normal text-center">Formulaire d'Inscription</h1></legend>
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.firstName) }}</div>
                        <div class="col-sm-6">{{ form_row(form.lastName) }}</div>
                    </div>
                    {{ form_row(form.email, { attr: { placeholder: 'vous@exemple.com' } }) }}
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                    {{ form_row(form.isSeller) }}
                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn-vendre">Créer mon compte</button>
                    </div>
                    {{ form_end(form) }}
            </fieldset>
        </div>
    </div>
</div>
    
   
{% endblock %}
