{% extends 'base.html.twig' %}

{% block title %}Products index{% endblock %}

{% block body %}
    <h1>Products index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prix_ht</th>
                <th>TVA</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.nom }}</td>
                <td>{{ product.prixHt }}</td>
                <td>{{ product.TVA }}</td>
                <td>
                    <a href="{{ path('seller_app_products_show', {'id': product.id}) }}">{{ ux_icon('lucide:eye') }}</a>
                    <a href="{{ path('seller_app_products_edit', {'id': product.id}) }}">{{ ux_icon('lucide:pencil') }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_app_products_new') }}">Create new</a>
{% endblock %}
