{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <form method="post" class="py-5 dots">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}
        <div class="d-flex">
            <div class="col-6 d-flex justify-content-center align-item-center">
                <fieldset>
                    <legend><h1 class="h3 my-3 font-weight-normal text-center">Veuillez vous connecter</h1></legend>
                    <div class="container-md">
                        <div class="formLogin">
                            <label for="username">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="formLogin">
                            <label for="password">mot de passe :</label>
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        </div>
                        <div class ="d-flex justify-content-center">
                            <button class="my-3 btn-vendre d-flex justify-content-left" type="submit">
                                Entrer
                            </button>
                        </div>
                        
                    </div>
                </fieldset>
            </div>
            <div class="col-6 d-flex flex-column justify-content-center">
                <h2 class="h3 my-3 font-weight-normal text-center">Vous n'avez pas encore de compte ?</h2>
                <p class="text-center">Veuillez cliquer sur le lien ci-dessou :</p>
                <div class ="d-flex justify-content-center form-link">
                    <a href="{{path('app_register')}}">Créer un compte</a>
                </div>
                
            </div>
        </div>
        
        
        
        
        
        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        
    </form>
{% endblock %}
