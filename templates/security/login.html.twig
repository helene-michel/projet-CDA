{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
    {% if app.user %}
        {# Déjà connecté : pas de formulaire, on propose de continuer ou de changer de compte. #}
        <section class="py-5 dots">
            <div class="d-flex flex-column align-items-center text-center gap-3 py-5">
                <h1 class="h3 my-3 font-weight-normal">Vous êtes déjà connecté</h1>
                <p class="mb-0">
                    Connecté en tant que <strong>{{ app.user.prenom ?: app.user.userIdentifier }}</strong>
                    {%- if app.user.prenom %} ({{ app.user.userIdentifier }}){% endif %}.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 mt-2">
                    <a href="{{ path('app_base') }}" class="btn-primary-b">Retour à l'accueil</a>
                    <a href="{{ logout_path() }}" class="btn-outline-b">Se déconnecter</a>
                </div>
            </div>
        </section>
    {% else %}
    <form method="post" class="py-5 dots">
        <div class="d-flex">
            <div class="col-6 d-flex justify-content-center align-item-center">
                <fieldset>
                    <legend><h1 class="h3 my-3 font-weight-normal text-center">Veuillez vous connecter</h1></legend>
                    <div class="container-md">
                        <div class="formLogin">
                            <label for="username">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control{{ error ? ' is-invalid' }}" autocomplete="email" required autofocus>
                        </div>
                        <div class="formLogin">
                            <label for="password">mot de passe :</label>
                            <input type="password" name="_password" id="password" class="form-control{{ error ? ' is-invalid' }}" autocomplete="current-password" required>
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        </div>
                        <div class ="d-flex justify-content-center">
                            <button class="my-3 btn-vendre d-flex justify-content-left" type="submit">
                                Entrer
                            </button>
                        </div>
                        
                    </div>
                </fieldset>
            </div>
            <div class="col-6 d-flex flex-column justify-content-center">
                <h2 class="h3 my-3 font-weight-normal text-center">Vous n'avez pas encore de compte ?</h2>
                <p class="text-center">Veuillez cliquer sur le lien ci-dessou :</p>
                <div class ="d-flex justify-content-center form-link">
                    <a href="{{path('app_register')}}">Créer un compte</a>
                </div>
                
            </div>
        </div>
        
        
        
        
        
        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        
    </form>
    {% endif %}
{% endblock %}
