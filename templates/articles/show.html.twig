      <span>© 2026 Bobine — tous droits réservés</span>
      <span>Fait en France</span>
    </div>
  </div>
</footer>
<script>
  function setGallery(el){
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    const main = document.getElementById('galleryMain');
    main.classList.remove('p-bleu','p-rouge','p-sable','p-dore','p-bleudark');
    main.classList.add(el.dataset.color);
  }

  function setTab(btn, id){
    document.querySelectorAll('.tabs-nav button').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + id).classList.add('active');
  }

  document.querySelectorAll('.size-pill').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.size-pill').forEach(s => s.classList.remove('active'));
      p.classList.add('active');
    });
  });
  document.querySelectorAll('.color-dot').forEach(d => {
    d.addEventListener('click', () => {
      document.querySelectorAll('.color-dot').forEach(c => c.classList.remove('active'));
      d.classList.add('active');
    });
  });
  document.querySelectorAll('.qty-stepper button').forEach((btn, i) => {
    btn.addEventListener('click', () => {
      const span = btn.parentElement.querySelector('span');
      let val = parseInt(span.textContent);
      val = i === 0 ? Math.max(1, val - 1) : val + 1;
      span.textContent = val;
    });
  });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
