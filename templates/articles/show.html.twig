  <div class="container-xxl">
    <div class="row gy-4">
      <div class="col-lg-4">
        <div class="brand-mark mb-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="7"/><path d="M12 5c-2 2-2 12 0 14M12 5c2 2 2 12 0 14M5 12h14"/></svg>
          Bobine
