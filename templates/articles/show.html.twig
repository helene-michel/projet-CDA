{% extends 'base.html.twig' %}

{% set seller = product.user %}
{% set sellerName = seller ? (seller.seller ? seller.seller.companyName : seller.displayName) : 'Créatrice indépendante' %}
{% set sellerInitials = sellerName|split(' ')|slice(0, 2)|map(word => word|first|upper)|join %}

{% block title %}{{ product.name }}{% endblock %}
{% block og_type %}product{% endblock %}
{% block og_image %}{{ absolute_url(product_image(product)) }}{% endblock %}
{% block meta_description %}
{%- set description = (product.description ?? '')|striptags|trim -%}
{{- description|length > 155 ? description|slice(0, 154) ~ '…' : description -}}
{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
    {{ {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: product.name,
        description: (product.description ?? '')|striptags|trim,
        image: absolute_url(product_image(product)),
        url: url('app_article', { id: product.id }),
        category: product.category ? product.category.name : null,
        offers: {
            '@type': 'Offer',
            price: price_incl_vat(product),
            priceCurrency: 'EUR',
            url: url('app_article', { id: product.id }),
        },
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}
</script>
{% endblock %}

{% block body %}

<!-- ===================== FIL D'ARIANE ===================== -->
<div class="container-xxl">
    <div class="breadcrumb-simple">
        <a href="{{ path('app_base') }}">Accueil</a> /
        {% if product.category %}
        <a href="{{ path('app_articles', { id: product.category.id }) }}">{{ product.category.name }}</a> /
        {% endif %}
        <span>{{ product.name }}</span>
    </div>
</div>

<!-- ===================== PRODUIT ===================== -->
<section class="container-xxl py-4">
    <div class="row g-5">

        <!-- GALERIE -->
        {% set images = product_images(product) %}
        <div class="col-lg-6" data-controller="gallery">
            <div class="gallery-main">
                <span class="badge-fait-main">Fait main</span>
                <img src="{{ images|first }}" alt="{{ product.name }}" id="galleryMainImg" data-gallery-target="main">
            </div>
            {% if images|length > 1 %}
            <div class="gallery-thumbs">
                {% for image in images %}
                <button type="button" class="thumb {{ loop.first ? 'active' }}" data-src="{{ image }}"
                    data-gallery-target="thumb" data-action="gallery#select" aria-label="Voir la photo {{ loop.index }}">
                    <img src="{{ image }}" alt="" loading="lazy">
                </button>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- INFOS -->
        <div class="col-lg-6">
            <h1 class="product-title-lg">{{ product.name }}</h1>
            <div class="creator-line">
                <span class="avatar-sm">{{ sellerInitials }}</span>
                <span>{{ sellerName }}</span>
            </div>
            <div class="price-big serif">{{ price_incl_vat(product)|format_currency('EUR') }} <small class="text-body-secondary fs-6">TTC</small></div>

            <form action="{{ path('app_cart_add', { id: product.id }) }}" method="post" data-controller="product">
                <div class="option-label">Taille</div>
                <div class="size-group">
                    {% for size in ['xs', 's', 'm', 'l', 'xl'] %}
                    <label class="size-pill" for="size-{{ size }}">
                        <input id="size-{{ size }}" name="size" type="radio" value="{{ size }}" required>
                        {{ size|upper }}
                    </label>
                    {% endfor %}
                </div>

                {% if product.colors is not empty %}
                <div class="option-label">Coloris</div>
                <div class="color-group">
                    {% for color in product.colors %}
                    <label class="color-dot" for="color-{{ color.id }}" style="background:{{ color.code }}" title="{{ color.name }}">
                        <input type="radio" id="color-{{ color.id }}" name="color" value="{{ color.id }}" required>
                        <span class="visually-hidden">{{ color.name }}</span>
                    </label>
                    {% endfor %}
                </div>
                {% endif %}

                <div class="option-label">Quantité</div>
                <div class="qty-row">
                    <div class="qty-stepper">
                        <button type="button" aria-label="Diminuer" data-action="product#less">−</button>
                        <input type="number" class="qty form-control" name="quantity" id="quantity" value="1" min="1"
                            aria-label="Quantité" data-product-target="quantity">
                        <button type="button" aria-label="Augmenter" data-action="product#more">+</button>
                    </div>
                </div>

                <div class="action-row">
                    <button type="submit" class="btn-primary-b btn-block">Ajouter au panier</button>
                </div>
                <input type="hidden" value="{{ csrf_token('add_cart') }}" name="_token">
            </form>

            <div class="mini-trust">
                <div class="item"><span class="pastille" style="background:var(--bleu-atelier)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V8l8-5 8 5v13" /><path d="M9 21v-7h6v7" /></svg></span>Cousue à la commande, expédiée sous 7 jours</div>
                <div class="item"><span class="pastille" style="background:var(--rouge-fil)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="1" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span>Paiement sécurisé</div>
                <div class="item"><span class="pastille" style="background:var(--dore)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21c4-4 7-7.5 7-11a7 7 0 0 0-14 0c0 3.5 3 7 7 11Z" /><circle cx="12" cy="10" r="2.4" /></svg></span>Cousue par {{ sellerName }}</div>
            </div>
        </div>
    </div>

    <!-- ONGLETS -->
    <div data-controller="navigation">
        <div class="tabs-nav" data-navigation-target="btnPanel">
            <button class="active" data-navigation-id-param="tabDesc" data-action="click->navigation#setTab">Description</button>
            {% if product.tags is not empty %}
            <button data-navigation-id-param="tabMaterials" data-action="click->navigation#setTab">Matières</button>
            {% endif %}
        </div>

        <div class="tab-panel active" id="tabDesc" data-navigation-target="tabPanel">
            <p>{{ product.description }}</p>
            <p>Comptez 5 à 7 jours de confection avant expédition.</p>
        </div>

        {% if product.tags is not empty %}
        <div class="tab-panel" id="tabMaterials" data-navigation-target="tabPanel">
            <ul>
                {% for tag in product.tags %}
                <li>{{ tag.name }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>

    <!-- CRÉATRICE -->
    <div class="creator-spotlight">
        <span class="avatar-lg">{{ sellerInitials }}</span>
        <div>
            <h3>{{ sellerName }}</h3>
            {% if seller and seller.seller %}
            <p>{{ seller.seller.description }}</p>
            {% endif %}
        </div>
    </div>

    {% if similarProducts is not empty %}
    <!-- VOUS AIMEREZ AUSSI -->
    <div class="section-head compact">
        <h2>Vous aimerez aussi</h2>
    </div>
    <div class="row g-4">
        {% for similar in similarProducts %}
        <div class="col-sm-6 col-lg-3">
            <div class="product-card">
                <a href="{{ path('app_article', { id: similar.id }) }}" class="product-img d-block">
                    <img src="{{ product_image(similar) }}" alt="" loading="lazy">
                </a>
                <div class="product-body">
                    <a href="{{ path('app_article', { id: similar.id }) }}" class="product-title">{{ similar.name }}</a>
                    <span class="product-creator">{{ similar.user ? similar.user.displayName }}</span>
                    <div class="product-footer"><span class="product-price">{{ price_incl_vat(similar)|format_currency('EUR') }}</span></div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</section>
{% endblock %}
