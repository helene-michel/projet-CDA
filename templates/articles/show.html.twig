{% extends 'base.html.twig' %}

{% block title %}Hello ArticlesController!{% endblock %}

{% block body %}

<!-- ===================== FIL D'ARIANE ===================== -->
<div class="container-xxl">
  <div class="breadcrumb-simple"><a href="#">Accueil</a> / <a href="#">Vêtements sur-mesure</a> / <a href="#">Robes</a> / <span>Robe en lin Camille</span></div>
</div>

<!-- ===================== PRODUIT ===================== -->
<section class="container-xxl py-4">
  <div class="row g-5">

    <!-- GALERIE -->
    <div class="col-lg-6">
      <div class="gallery-main p-bleu weave" id="galleryMain">
        <span class="badge-fait-main">Fait main</span>
      </div>
      <div class="gallery-thumbs">
        <div class="thumb active p-bleu weave" data-color="p-bleu" onclick="setGallery(this)"></div>
        <div class="thumb p-rouge weave" data-color="p-rouge" onclick="setGallery(this)"></div>
        <div class="thumb p-sable weave" data-color="p-sable" onclick="setGallery(this)"></div>
        <div class="thumb p-dore weave" data-color="p-dore" onclick="setGallery(this)"></div>
      </div>
    </div>

    <!-- INFOS -->
    <div class="col-lg-6">
        <div>
            <h1 class="product-title-lg">{{ products.nom }}</h1>
            
            <div class="creator-line">
                <span class="avatar-sm">FL</span><!--ajouter avatar du seller plutot que les initiales-->
                    <a href="#">{{ products.User.nom }} {{ products.User.prenom }}</a>
            </div>
        </div>
        <div class="price-big serif">{{ products.prixht }} €</div>

        <p style="color:#4B5563; max-width:48ch; margin-bottom:1.6rem;">{{ products.description }}</p>      
      <div class="option-label">Taille</div>
      <div class="size-group">
        <div class="size-pill">XS</div>
        <div class="size-pill active">S</div>
        <div class="size-pill">M</div>
        <div class="size-pill">L</div>
        <div class="size-pill">XL</div>
      </div>

      <div class="option-label">Coloris</div>
      <div class="color-group">
        <div class="color-dot active" style="background:var(--bleu-atelier-dark)"></div>
        <div class="color-dot" style="background:var(--sable)"></div>
        <div class="color-dot" style="background:var(--rouge-fil)"></div>
      </div>

      <div class="qty-row">
        <div class="qty-stepper">
          <button type="button" aria-label="Diminuer">−</button>
          <span>1</span>
          <button type="button" aria-label="Augmenter">+</button>
        </div>
      </div>

      <div class="action-row">
        <button class="btn-primary-b btn-block">Ajouter au panier</button>
      </div>

      <div class="mini-trust">
        <div class="item"><span class="pastille" style="background:var(--bleu-atelier)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-7h6v7"/></svg></span>Cousue à la commande, expédiée sous 7 jours</div>
        <div class="item"><span class="pastille" style="background:var(--rouge-fil)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>Paiement sécurisé</div>
        <div class="item"><span class="pastille" style="background:var(--dore)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21c4-4 7-7.5 7-11a7 7 0 0 0-14 0c0 3.5 3 7 7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg></span>Cousue à Rennes par Atelier Fleur de Lin</div>
      </div>
    </div>
  </div>

  <!-- ONGLETS -->
  <div class="tabs-nav">
    <button class="active" onclick="setTab(this,'desc')">Description</button>
    <button onclick="setTab(this,'compo')">Composition &amp; entretien</button>
  </div>

  <div class="tab-panel active" id="tab-desc">
    <p>{{ products.description }}</p>
    <p>Comptez 5 à 7 jours de confection avant expédition.</p>
  </div>

  <div class="tab-panel" id="tab-compo">
    <ul>
      <li>100% lin lavé, origine France</li>
      <li>Doublure en coton bio</li>
      <li>Lavage à 30°C, cycle délicat</li>
      <li>Repassage à température moyenne, envers du tissu</li>
      <li>Ne pas mettre au sèche-linge</li>
    </ul>
  </div>

  <!-- CRÉATRICE -->
  <div class="creator-spotlight">
    <span class="avatar-lg">FL</span>
    <div>
      <h3>Atelier Fleur de Lin</h3>
      <p>Couturière installée à Rennes depuis 2018, spécialisée dans les vêtements en lin français. Plus de 600 pièces cousues à la main pour ses clientes.</p>
    </div>
    <a href="#" class="btn-outline-b">Voir la boutique</a>
  </div>

