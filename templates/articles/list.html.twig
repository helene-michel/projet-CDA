{% extends 'base.html.twig' %}

            {% block title %}Hello ArticlesController!{% endblock %}

            {% block body %}
<header class="page-head">
    <div class="container-xxl">
        <div class="breadcrumb-b"><a href="#">Accueil</a> / <span>Vêtements sur-mesure</span></div>
        <span class="hero-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path
                    d="M20 6 9 17l-5-5"/></svg>
            100% cousu par des créatrices françaises
            </span>
        <h1>Toutes les créations</h1>
        <p class="count"> 0 pièces disponibles, cousues à la main partout en France.</p>
    </div>
</header>
<!-- ===================== CONTENU ===================== -->
<section 
    class="container-xxl pb-5"
    data-controller="filter" 
    data-filter-route-value="{{ absolute_url(path('app_articles_load', {id:category.id})) }}" 
    data-filter-max-value="{{ productMax }}"
    data-filter-csrf-value="{{ csrf_token('products_load') }}"
>
    <div class="row g-4">

        <!-- FILTRES -->
        <aside class="col-lg-3">
            <div class="filters">
                <h2>Filtrer</h2>
                <div class="filter-group">
                    <h3>Prix</h3>
                    <input type="range" min="0" max="{{ productMax }}" value="{{ productMax }}" class="form-range" data-filter-target="choicePrice" data-action="mouseup->filter#priceFilter keyup->filter#priceFilter">
                    <div class="price-values"><span>0 €</span><span>{{ productMax }} €</span></div>
                </div>

                <div class="filter-group">
                    <h3>Caractéristiques</h3>
                </div>
                <div class="filter-group my-3">
                    <div class="filter-search">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8A8578" stroke-width="2">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="M21 21l-4.3-4.3"/>
                        </svg>
                        <input type="text" id="matiereSearch" data-action="input->filter#matiereSearch" placeholder="Rechercher une matière…">
                    </div>
                    <div class="filter-scroll" id="matiereList" data-filter-target="matiereList">
                        {% for tag in tags %}
                            <div class="form-check {{ (loop.index >6)?"filter-extra" }} ">
                                <input class="form-check-input" type="checkbox"  data-action="click->filter#filterTag" data-id="{{ tag.id }}">
                                <label class="form-check-label" for="m44">{{ tag.nom }}</label>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="filter-more" id="matiereToggle" data-filter-target="matiereToggle" data-action="click->filter#matiereToggle">Voir toutes les matières</button>
                </div>
                <a class="btn-reset" href="{{ path('app_articles', {id:category.id}) }}">Réinitialiser les filtres</a>
            </div>
        </aside>
        <!-- LISTE DES CRÉATIONS -->
        <div class="col-lg-9">
            <div class="toolbar">
                <span style="font-size:.88rem; color:#5B6472;">0 résultats</span>
                <div class="d-flex align-items-center gap-3">
                    <select data-action="filter#orderPrice">
                        <option value="ASC">Prix croissant</option>
                        <option value="DESC">Prix décroissant</option>
                    </select>
                </div>
            </div>
            <div data-filter-target="results" class="row g-4 d-none"></div>
            <div data-filter-target="skeleton" class="row g-4">
                {% for i in 1..8 %}
                    <div class="col-sm-6 col-lg-4">
                        <div class="product-card">
                            <div class="product-img p-bleu">
                                <div class="weave"></div>
                                <span class="badge-fait-main"></span>
                                <a href="#" class="fav" aria-label="Ajouter aux favoris">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8">
                                        <path d="M12 21c4-4 7-7.5 7-11a7 7 0 0 0-14 0c0 3.5 3 7 7 11Z"/>
                                    </svg>
                                </a>
                            </div>
                            <div class="product-body">
                                <h3 class="product-title"></h3>
                                <span class="product-creator"></span>
                                <span class="product-price"></span>
                                <div class="product-footer">

                                    <span class="product-rating">
                                        <a href= # class="btn-outline-b">Détail</a>
                                        <a href= # class="btn-primary-b">Panier</a>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %} 
                
                
                {% endblock %}
